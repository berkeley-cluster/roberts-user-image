#!/usr/bin/env python3
"""cluster-queue: the Roberts Cluster's Kueue queues, like squeue/sinfo.

Shows each ClusterQueue's use and capacity per GPU type, the workloads
waiting in it with their position, and your own workloads (in your
kubeconfig's namespace, or -n NAMESPACE). Also runs as
"kubectl cluster-queue". To manage your own workloads, use
"kubectl kueue".

    cluster-queue [-n NAMESPACE] [--context CONTEXT]
                  [--kubeconfig FILE]
"""

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone

UNITS = {"Ki": 2**10, "Mi": 2**20, "Gi": 2**30, "Ti": 2**40,
         "k": 10**3, "M": 10**6, "G": 10**9, "T": 10**12, "m": 1e-3}


# kubectl's global flags given to us, passed on to every kubectl call
KUBECTL_FLAGS = []


def kubectl(*args):
    p = subprocess.run(["kubectl", *KUBECTL_FLAGS, *args, "-o", "json"],
                       capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(p.stderr.strip())
    return json.loads(p.stdout)


def raw(path):
    p = subprocess.run(["kubectl", *KUBECTL_FLAGS, "get", "--raw", path],
                       capture_output=True, text=True)
    if p.returncode != 0:
        return None
    return json.loads(p.stdout)


def qty(v):
    v = str(v)
    for suffix in sorted(UNITS, key=len, reverse=True):
        if v.endswith(suffix):
            return float(v[:-len(suffix)]) * UNITS[suffix]
    return float(v)


def fmt(resource, v):
    if resource == "memory":
        return f"{qty(v) / 2**30:.0f}Gi"
    n = qty(v)
    return f"{n:g}"


def age(ts):
    if not ts:
        return ""
    t = datetime.fromisoformat(ts.replace("Z", "+00:00"))
    s = int((datetime.now(timezone.utc) - t).total_seconds())
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m = s // 60
    return f"{d}d{h}h" if d else f"{h}h{m}m" if h else f"{m}m"


def table(rows, header):
    rows = [header] + rows
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(header))]
    for r in rows:
        print("  " + "  ".join(str(c).ljust(w)
                               for c, w in zip(r, widths)).rstrip())


def resources(podsets):
    """GPUs, CPUs and memory requested by a workload's pod sets."""
    total = {}
    for ps in podsets:
        count = ps.get("count", 1)
        for c in ps["template"]["spec"].get("containers", []):
            res = c.get("resources", {})
            req = dict(res.get("limits", {}), **res.get("requests", {}))
            for r in ("nvidia.com/gpu", "cpu", "memory"):
                if r in req:
                    total[r] = total.get(r, 0) + qty(req[r]) * count
    return total


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("-n", "--namespace",
                    help="whose workloads to show (default: the "
                         "context's namespace)")
    ap.add_argument("--context", help="kubeconfig context to use")
    ap.add_argument("--kubeconfig", help="kubeconfig file to use")
    args = ap.parse_args()
    for flag in ("context", "kubeconfig"):
        if getattr(args, flag):
            KUBECTL_FLAGS.append(f"--{flag}={getattr(args, flag)}")

    for cq in kubectl("get", "clusterqueues")["items"]:
        name = cq["metadata"]["name"]
        print(f"Queue {name}")
        nominal = {}
        for g in cq["spec"].get("resourceGroups", []):
            for f in g["flavors"]:
                for r in f["resources"]:
                    nominal[(f["name"], r["name"])] = r["nominalQuota"]
        used = {}
        for f in cq.get("status", {}).get("flavorsUsage", []):
            for r in f["resources"]:
                used[(f["name"], r["name"])] = r.get("total", 0)
        rows = []
        for flavor in dict.fromkeys(f for f, _ in nominal):
            row = [flavor]
            for r in ("nvidia.com/gpu", "cpu", "memory"):
                n = nominal.get((flavor, r))
                u = used.get((flavor, r), 0)
                row.append(f"{fmt(r, u)}/{fmt(r, n)}" if n is not None
                           else "")
            rows.append(row)
        table(rows, ["GPU TYPE", "GPUS", "CPUS", "MEMORY"])

        pending = raw("/apis/visibility.kueue.x-k8s.io/v1beta2/"
                      f"clusterqueues/{name}/pendingworkloads")
        items = (pending or {}).get("items", [])
        print(f"  Waiting: {len(items)}")
        if items:
            table([[w.get("positionInClusterQueue", -1) + 1,
                    w["metadata"]["namespace"].removeprefix("user-"),
                    w["metadata"]["name"], w.get("priority", 0),
                    age(w["metadata"].get("creationTimestamp"))]
                   for w in items],
                  ["POS", "USER", "WORKLOAD", "PRIORITY", "WAITING"])
        print()

    ns_args = ["-n", args.namespace] if args.namespace else []
    mine = kubectl("get", "workloads", *ns_args)["items"]
    print("Your workloads")
    if not mine:
        print("  none")
        return
    rows = []
    for w in mine:
        st = w.get("status", {})
        conds = {c["type"]: c["status"] for c in st.get("conditions", [])}
        if conds.get("Finished") == "True":
            state = "finished"
        elif conds.get("Admitted") == "True":
            state = "admitted"
        else:
            state = "waiting"
        flavors = sorted({f for ps in (st.get("admission") or {}).get(
            "podSetAssignments", []) for f in ps.get("flavors", {}).values()})
        req = resources(w["spec"].get("podSets", []))
        rows.append([w["metadata"]["name"], state, ",".join(flavors),
                     fmt("gpu", req.get("nvidia.com/gpu", 0)),
                     fmt("cpu", req.get("cpu", 0)),
                     fmt("memory", req.get("memory", 0)),
                     age(w["metadata"].get("creationTimestamp"))])
    table(rows, ["WORKLOAD", "STATE", "GPU TYPE", "GPUS", "CPUS",
                 "MEMORY", "AGE"])


if __name__ == "__main__":
    main()
